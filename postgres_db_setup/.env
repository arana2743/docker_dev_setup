# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
# Database username
POSTGRES_USER=root

# Database password (wrap in quotes if it contains special characters like # or $)
POSTGRES_PASSWORD="root@123"

# Initial database name to create
POSTGRES_DB=test_db

# Host port mapping (change if 5432 is already in use on your Mac)
POSTGRES_PORT=5432


# ==============================================================================
# pgAdmin Web Console Configuration
# ==============================================================================
# Login email for pgAdmin
PGADMIN_DEFAULT_EMAIL="admin@admin.com"

# Login password for pgAdmin
PGADMIN_DEFAULT_PASSWORD="admin@123"

# Port to access pgAdmin in your browser (http://localhost:5050)
PGADMIN_PORT=5050